{
 "datasets": [
  {
   "name": "kpis",
   "displayName": "kpis",
   "queryLines": [
    "SELECT count(*) AS images,\n",
    "       avg(CASE WHEN disposition = 'FLAGGED' THEN 1 ELSE 0 END) AS flagged_rate,\n",
    "       avg(CASE WHEN cd_spec_status = 'FAIL' THEN 1 ELSE 0 END) AS cd_fail_rate,\n",
    "       count(DISTINCT lot_id) AS lots\n",
    "FROM ws_azure_classic_eastus_pedro.fabs_metrology.v_image_results\n"
   ]
  },
  {
   "name": "trend",
   "displayName": "trend",
   "queryLines": [
    "SELECT capture_date, experiment_id, sum(mean_cd_nm * images) / sum(images) AS mean_cd_nm, sum(images) AS images\n",
    "FROM ws_azure_classic_eastus_pedro.fabs_metrology.v_daily_cd_trend GROUP BY ALL\n"
   ]
  },
  {
   "name": "tool_trend",
   "displayName": "tool_trend",
   "queryLines": [
    "SELECT capture_date, tool_id, sum(mean_cd_nm * images) / sum(images) AS mean_cd_nm, sum(images) AS images\n",
    "FROM ws_azure_classic_eastus_pedro.fabs_metrology.v_daily_cd_trend GROUP BY ALL\n"
   ]
  },
  {
   "name": "tool_matching",
   "displayName": "tool_matching",
   "queryLines": [
    "SELECT * FROM ws_azure_classic_eastus_pedro.fabs_metrology.v_tool_matching\n"
   ]
  },
  {
   "name": "lots",
   "displayName": "lots",
   "queryLines": [
    "SELECT * FROM ws_azure_classic_eastus_pedro.fabs_metrology.v_lot_summary\n"
   ]
  },
  {
   "name": "defects",
   "displayName": "defects",
   "queryLines": [
    "SELECT experiment_id, predicted_class, count(*) AS images\n",
    "FROM ws_azure_classic_eastus_pedro.fabs_metrology.v_image_results WHERE predicted_class <> 'none' GROUP BY ALL\n"
   ]
  },
  {
   "name": "outliers",
   "displayName": "outliers",
   "queryLines": [
    "SELECT * FROM ws_azure_classic_eastus_pedro.fabs_metrology.v_cd_outliers\n"
   ]
  },
  {
   "name": "runs",
   "displayName": "runs",
   "queryLines": [
    "SELECT * FROM ws_azure_classic_eastus_pedro.fabs_metrology.processing_runs\n"
   ]
  },
  {
   "name": "quarantine",
   "displayName": "quarantine",
   "queryLines": [
    "SELECT reject_reason, count(*) AS files FROM ws_azure_classic_eastus_pedro.fabs_metrology.image_quarantine GROUP BY ALL\n"
   ]
  },
  {
   "name": "review_state",
   "displayName": "review_state",
   "queryLines": [
    "SELECT CASE state WHEN 'PENDING_REVIEW' THEN 'Pending review' WHEN 'PENDING_APPROVAL' THEN 'Pending approval'\n",
    "  WHEN 'APPROVED_GOOD' THEN 'Approved / Good' WHEN 'REJECTED_BAD' THEN 'Rejected / Bad' ELSE 'Needs rework' END AS state,\n",
    "  count(*) AS images FROM ws_azure_classic_eastus_pedro.fabs_review.v_review_items_current GROUP BY ALL\n"
   ]
  },
  {
   "name": "agreement",
   "displayName": "agreement",
   "queryLines": [
    "SELECT disposition AS model_disposition, coalesce(reviewer_verdict, 'NOT YET') AS reviewer_verdict, count(*) AS images\n",
    "FROM ws_azure_classic_eastus_pedro.fabs_review.v_review_items_current WHERE reviewed_at IS NOT NULL OR approved_at IS NOT NULL GROUP BY ALL\n"
   ]
  },
  {
   "name": "actions",
   "displayName": "actions",
   "queryLines": [
    "SELECT date(action_ts) AS day, action, count(*) AS actions\n",
    "FROM ws_azure_classic_eastus_pedro.fabs_review.v_review_actions WHERE acting_role <> 'system' GROUP BY ALL\n"
   ]
  },
  {
   "name": "action_log",
   "displayName": "action_log",
   "queryLines": [
    "SELECT action_ts, image_id, actor_email, acting_role, action, from_state, to_state, reason_code, comment, sod_override\n",
    "FROM ws_azure_classic_eastus_pedro.fabs_review.v_review_actions WHERE acting_role <> 'system'\n"
   ]
  }
 ],
